# DE4SDV Experimental Read-Only Systems Modeling API — public reverse proxy.
#
# Internet -> Caddy (HTTPS) -> read-only sysml2-api or bounded viewer + Ask
#   -> PostgreSQL (container network only).
#
# Security properties enforced here:
#   - Automatic TLS via Let's Encrypt (no manual cert handling).
#   - STRICT method allowlist: only GET, HEAD, and OPTIONS reach the API.
#     Every other method — POST, PUT, PATCH, DELETE, and any unknown or
#     extension method — is rejected at the proxy with 405 before any bytes
#     touch the API service. The handlers are wrapped in an explicit `route`
#     block so the 405 rule is evaluated before the reverse proxy (Caddy's
#     directive sorter otherwise orders respond AFTER proxy).
#   - The API and PostgreSQL are only reachable on the internal Docker
#     network; no host ports are published for them.
#   - Public rate limiting (caddy-ratelimit, built into the image; see
#     deployment/caddy/Dockerfile for the pinned module revision) and
#     request-size limits.
#
# The upstream pilot implementation does define POST endpoints (projects,
# commits). The proxy intentionally disables ALL mutation operations for the
# public surface; ingestion happens server-side through the validated
# importer path (ADR 0011/0013), never through the public interface.
{
	email {$ACME_EMAIL}
}

sysml-api.de4sdv.org {
	encode zstd gzip

	route {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			-Server
		}

		# Positive allowlist: GET/HEAD/OPTIONS pass; everything else — known
		# mutations (POST/PUT/PATCH/DELETE), unknown and extension methods —
		# is rejected 405 at the proxy.
		@allowed_methods method GET HEAD OPTIONS
		@rejected_methods not method GET HEAD OPTIONS
		respond @rejected_methods 405 {
			close
		}

		# Public rate limiting (caddy-ratelimit @b8d8c9a9): exactly 50 events
		# per 10 s sliding window, keyed per remote host. There is no separate
		# burst parameter in this module version; exceeding the window budget
		# fails fast with HTTP 429.
		rate_limit {
			zone static {
				key {remote_host}
				events 50
				window 10s
			}
		}

		# Cap request bodies (the API is read-only; uploads are invalid).
		request_body {
			max_size 1MB
		}

		# Small machine-readable deployment-status document, served directly
		# by the proxy from the runtime status directory (mounted read-only
		# from ${DEPLOY_DIR}/status by compose). Generated at deploy time by
		# deployment/scripts/deploy.py; contains no secrets or internal paths.
		handle /deployment-status.json {
			root * /srv/de4sdv-status
			file_server
		}

		handle {
			reverse_proxy sysml2-api:9000 {
				health_uri /projects
				health_interval 30s
				health_timeout 10s
				header_up X-Forwarded-Proto {scheme}
				header_up Host {upstream_hostport}
			}
		}
	}
}

viewer.de4sdv.org {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	route {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			-Server
		}

		# Warmup diagnostics may contain operational detail and are internal-only.
		@ask_internal path /_ask_warmup
		respond @ask_internal 404

		handle /ask {
			@ask_post method POST
			handle @ask_post {
				# One static key limits total hourly spend; the remote-host key
				# separately stops one client from consuming the shared budget.
				rate_limit {
					zone ask_global {
						key ask-global
						events 60
						window 1h
					}
					zone ask_daily {
						key ask-daily
						events 120
						window 24h
					}
					zone ask_per_ip {
						key {remote_host}
						events 3
						window 1m
					}
				}
				request_body {
					max_size 16KB
				}
				reverse_proxy ask-viewer:8787 {
					health_uri /ask-status.json
					health_interval 30s
					health_timeout 10s
					transport http {
						response_header_timeout 180s
					}
				}
			}
			respond 405 {
				close
			}
		}

		@read method GET HEAD
		handle @read {
			reverse_proxy ask-viewer:8787 {
				transport http {
					response_header_timeout 180s
				}
			}
		}

		respond 405 {
			close
		}
	}

	# Preserve browse-only access if the dynamic viewer is unavailable. The
	# native Pages mirror remains public after its custom domain is removed.
	# POST /ask is handled above and never reaches this fallback.
	handle_errors {
		@fallback_read method GET HEAD
		handle @fallback_read {
			rewrite * /DE4SDV{uri}
			reverse_proxy https://de4sdv.github.io {
				header_up Host de4sdv.github.io
			}
		}
		respond 502
	}
}
