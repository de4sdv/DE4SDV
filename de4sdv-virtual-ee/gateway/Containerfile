# DE4SDV zonal CAN gateway (central node)
#
# Two buses arrive here over the slice, each from one zone, carried by the
# DE4SDV bridge. The gateway forwards between them under a per-frame allow-list,
# so the vehicle network exists as a routed path rather than a set of isolated
# segments.
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 can-utils tini \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir python-can==4.6.1

# DE4SDV's own transport, the same file the zones carry. One codec on both ends
# of every wire means the framing cannot drift between the two images.
COPY transport/bridge.py /opt/gw/bridge.py
COPY gateway/router.py /opt/gw/router.py
COPY gateway/entrypoint.sh /opt/gw/entrypoint.sh
RUN chmod +x /opt/gw/entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/gw/entrypoint.sh"]
