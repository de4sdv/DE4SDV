{
  "Vehicle": {
    "children": {
      "Body": {
        "type": "branch",
        "description": "All body components.",
        "children": {
          "Lights": {
            "type": "branch",
            "description": "Exterior lights.",
            "children": {
              "Beam": {
                "type": "branch",
                "description": "Headlamp beam signals.",
                "children": {
                  "Low": {
                    "type": "branch",
                    "description": "Low beam.",
                    "children": {
                      "IsOn": {
                        "datatype": "boolean",
                        "type": "actuator",
                        "description": "Low beam on/off. The command arrives as actuator_target, the state reported by the zone ECU as value.",
                        "dbc2vss": { "signal": "Headlamp_Low_On", "interval_ms": 100 },
                        "vss2dbc": { "signal": "Headlamp_Low_Req" }
                      },
                      "IsDefect": {
                        "datatype": "boolean",
                        "type": "sensor",
                        "description": "Low beam defect reported by the zone ECU.",
                        "dbc2vss": { "signal": "Headlamp_Fault", "interval_ms": 200 }
                      }
                    }
                  },
                  "High": {
                    "type": "branch",
                    "description": "High beam.",
                    "children": {
                      "IsOn": {
                        "datatype": "boolean",
                        "type": "actuator",
                        "description": "High beam on/off. The command arrives as actuator_target, the state reported by the zone ECU as value.",
                        "dbc2vss": { "signal": "Headlamp_High_On", "interval_ms": 100 },
                        "vss2dbc": { "signal": "Headlamp_High_Req" }
                      },
                      "IsDefect": {
                        "datatype": "boolean",
                        "type": "sensor",
                        "description": "High beam defect reported by the zone ECU.",
                        "dbc2vss": { "signal": "Headlamp_Fault", "interval_ms": 200 }
                      }
                    }
                  }
                }
              }
            }
          },
          "Windshield": {
            "type": "branch",
            "description": "Windshield signals.",
            "children": {
              "Front": {
                "type": "branch",
                "description": "Front windshield.",
                "children": {
                  "Wiping": {
                    "type": "branch",
                    "description": "Front wiper system.",
                    "children": {
                      "Mode": {
                        "datatype": "string",
                        "type": "actuator",
                        "allowed": ["OFF", "SLOW", "MEDIUM", "FAST", "INTERVAL", "RAIN_SENSOR"],
                        "description": "Requested wipe mode. The command arrives as actuator_target, the mode the zone ECU reports as value.",
                        "dbc2vss": { "signal": "Wiper_Mode_State", "interval_ms": 100 },
                        "vss2dbc": { "signal": "Wiper_Mode_Req" }
                      },
                      "System": {
                        "type": "branch",
                        "description": "Wiper system state.",
                        "children": {
                          "ActualPosition": {
                            "datatype": "float",
                            "type": "actuator",
                            "min": 0,
                            "max": 100,
                            "unit": "percent",
                            "description": "Actual wiper position reported by the zone ECU, 0 = park, 100 = full sweep.",
                            "dbc2vss": { "signal": "Wiper_Position_pct", "interval_ms": 100 }
                          },
                          "IsPositionReached": {
                            "datatype": "boolean",
                            "type": "sensor",
                            "description": "True when the wiper reached the position commanded for the current sequence number. This is the acknowledgement the reference demo never sent.",
                            "dbc2vss": { "signal": "Wiper_Position_Reached", "interval_ms": 100 }
                          },
                          "IsWiperError": {
                            "datatype": "boolean",
                            "type": "sensor",
                            "description": "True if the zone ECU reports a wiper fault.",
                            "dbc2vss": { "signal": "Wiper_Error", "interval_ms": 200 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
