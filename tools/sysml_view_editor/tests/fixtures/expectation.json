{
  "roles": [
    "producer",
    "relay",
    "consumer"
  ],
  "ports": [
    "producer.requestOut",
    "relay.requestIn",
    "relay.responseOut",
    "consumer.responseIn"
  ],
  "flows": [
    ["producer.requestOut.request", "relay.requestIn.request"],
    ["relay.responseOut.response", "consumer.responseIn.response"]
  ],
  "payloads": ["request", "response"]
}
