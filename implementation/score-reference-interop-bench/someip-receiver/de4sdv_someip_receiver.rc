# DE4SDV minimal SOME/IP receiver of the AAOS SDV guest (INC-MW-011).
#
# For the eng or userdebug image of the bench only: seclabel u:r:su:s0, with
# SELinux permissive as on the INC-AEBS-010 bench. A product form needs its
# own domain. The server address is the host end of cvd-ebr. The service is
# not oneshot, so init restarts the receiver when it exits.
#
# The ingress is oneshot: it exits when its connect fails or its stream
# closes. This file sets only the port of its frame server and no ingress
# trigger. The receiver sets the other properties itself, in this order,
# after its loopback server listens and at each of its starts: the host
# (which de4sdv_aebs_ingress.rc also takes as a start), then
# de4sdv.aebs.ingress.start 0 and 1, which start the ingress again after a
# restart of the receiver. The discard rule has no option: its margin is
# fixed at 20 ms.
service de4sdv_someip_receiver /system/bin/de4sdv_someip_receiver --server-address 192.168.98.1 --status-period-s 10 --announce-property de4sdv.aebs.frame_server.host=127.0.0.1 --announce-property de4sdv.aebs.ingress.start=0 --announce-property de4sdv.aebs.ingress.start=1
    class late_start
    user system
    group inet
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    setprop de4sdv.aebs.frame_server.port 4731
    start de4sdv_someip_receiver
