# DE4SDV minimal SOME/IP receiver of the AAOS SDV guest (INC-MW-011).
#
# For the eng or userdebug image of the bench only: seclabel u:r:su:s0, with
# SELinux permissive as on the INC-AEBS-010 bench (bench only; a product
# needs its own SELinux domain, GAP-MW-038). CI does not build this file.
# The server address is the host end of cvd-ebr. The service is not oneshot,
# so init restarts the receiver when it exits.
#
# The ingress is oneshot: it exits when its connect fails or its stream
# closes. This file sets only the port of its frame server and no ingress
# trigger. At each of its starts, after its loopback server listens, the
# receiver sets the host (which de4sdv_aebs_ingress.rc also takes as a
# start), then de4sdv.aebs.ingress.start to 0 and 1. Until its first client
# connects, it sets 0 and 1 again every 1 s, at most 10 times, because an
# old ingress can still run or wait for its reap; after the first client it
# never starts the ingress again. The discard rule has no option: its margin
# is fixed at 20 ms.
#
# --log-frames gives a line per served frame (every dropped frame gives its
# line anyway), so the records of the guest can be evaluated as the CI runs
# are. gentle_kill: init's stop sends SIGTERM first, so the receiver sends
# StopSubscribe and logs its final status before it exits.
service de4sdv_someip_receiver /system/bin/de4sdv_someip_receiver --server-address 192.168.98.1 --status-period-s 10 --log-frames --announce-property de4sdv.aebs.frame_server.host=127.0.0.1 --ingress-start-property de4sdv.aebs.ingress.start
    class late_start
    gentle_kill
    user system
    group inet
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    setprop de4sdv.aebs.frame_server.port 4731
    start de4sdv_someip_receiver
