<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS configuration of every host ROS 2 process of the S-CORE
  reference interoperability bench (INC-MW-011), the same as the AEBS
  Autoware benches use. ros_environment.sh points CYCLONEDDS_URI to this file.

  - Loopback only, without multicast: discovery goes to the localhost peer.
  - Without multicast, each participant needs its own participant index.
    With the CycloneDDS default (MaxAutoParticipantIndex 9), at most 9
    processes on the host get a participant: a bind at the last index fails
    too (CycloneDDS 0.10.5 q_init.c:1609, 1627-1631). For the next process
    rclcpp throws, and the adapter, which links baselibs' abort override,
    would abort. This file's 120 allows 120 processes. The startup probe of
    the bench measured 9 of 11 with the default.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="localhost"/>
      </Peers>
    </Discovery>
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
