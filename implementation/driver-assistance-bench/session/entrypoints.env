# The entry points the session calls on each host, as paths relative to the bench folder
# (implementation/driver-assistance-bench/) inside the uploaded kit. Sourced by da_session.sh; every value can be
# overridden from the environment (ENTRY_SIM_CALIBRATE and ENTRY_GUEST_PREPARE also by an empty value, which the
# preflight then refuses). The contract of each (arguments, outputs, exit codes) is in README.md
# "Entry-point contracts". The session checks before any VM starts that each entry its session kind needs is in the
# kit and executable.

# S-CORE host (owners: the S-CORE build lane, the Launch Manager lane, the warning-app lane)
: "${ENTRY_SCORE_P10_1:=score-build/scripts/p10_1_check.sh}"            # P10-1: build check, clip replay, late subscriber
: "${ENTRY_SCORE_START:=score-path/scripts/start_score_side.sh}"          # Launch Manager with its five processes
: "${ENTRY_SCORE_INJECT:=ivi-warning/scripts/inject_warning_requests.sh}" # P10-3: injected warning requests
: "${ENTRY_SCORE_STOP:=score-path/scripts/stop_score_side.sh}"            # SIGTERM, wait, collect

# simulator host (owners: this lane for the server and the recorder, the world-side lane for the scenario)
: "${ENTRY_SIM_SETUP:=session/remote/sim_setup.sh}"
: "${ENTRY_SIM_WARMUP:=world-side/scripts/warmup.sh}"
: "${ENTRY_SIM_RUN:=world-side/scripts/run_scenario.sh}"
: "${ENTRY_SIM_RECORD:=recording/chase_recorder.py}"
: "${ENTRY_SIM_CALIBRATE=world-side/scripts/calibrate.sh}"              # p10-2: ASM-DRIVING-005, camera capture

# guest host (owners: this lane; the guest build lane for the optional prepare step)
: "${ENTRY_GUEST_UP:=session/remote/guest_up.sh}"
: "${ENTRY_GUEST_PREPARE=session/remote/guest_prepare.sh}"              # the app and its ACLs, IVI reboot, verify
: "${ENTRY_GUEST_APP_RESTART:=session/remote/app_restart.sh}"             # am start -S before each window
: "${ENTRY_GUEST_OFFER_CHECK:=session/remote/offer_check.sh}"             # multicast route, the broker's unit
: "${ENTRY_GUEST_CLOCK:=session/remote/ivi_clock.sh}"
: "${ENTRY_GUEST_CAPTURE:=recording/display_capture.sh}"

# both ends of the VXLAN segment (reused from INC-DRIVING-001's session kit)
: "${ENTRY_VXLAN:=session/remote/cross_vm_guest_bridge.sh}"

# The guests' stop, run on the guest host before its VM stops, by the exit trap and by the safety net: cvd stop of
# every group, then the crosvm count (session/remote/guest_stop.sh). Not the kit's smoke_boot.sh --stop-only: its
# image records are stale since 2026-11-17 and it refuses (guest-prep-20261118 report). $DA_SESSION_ID is replaced
# by the session id. The session checks after it that no crosvm is left, and never stops the host otherwise.
: "${GUEST_STOP_CMD:=bash \$HOME/da-kit/\$DA_SESSION_ID/bench/session/remote/guest_stop.sh}"

# The simulator host's Python with CARLA 1.0's own wheel (left by SIM20-G4 on the G4's disk)
: "${SIM_PY:=/opt/sim20g4/venv/bin/python}"

# The runs of P10-2 (world-side/README.md "Commands on the simulator host"): the steering calibration
# (ASM-DRIVING-006) with the candidate, then the scenario's setting P10_2_RUNS times, each with its own S-CORE side
# start and stop, the app restarted, the IVI clock set and the display captured around it.
: "${P10_2_SCENARIO:=SC-DRIVING-012}"
: "${P10_2_SETTING:=20kmh}"
: "${P10_2_RUNS:=2}"
: "${P10_2_CALIB_STEER:=1}"

# The IVI warning app (ivi-warning-app/app/AndroidManifest.xml: package and launcher activity; WarningRecord.java:
# the record file under the app's files directory; @user@ is the IVI's current user, read at the capture)
: "${APP_PACKAGE:=org.de4sdv.collisionwarning}"
: "${APP_COMPONENT:=org.de4sdv.collisionwarning/.MainActivity}"
: "${APP_RECORD_PATHS:=/data/user/@user@/org.de4sdv.collisionwarning/files/warning.jsonl}"

# The camera calibration file (camera_calibration.py make-h), made on the lead host: a VisionPilot clone holding the
# pin and a Python with OpenCV and numpy. The preflight checks both, and takes upstream's checkerboard from the pin
# into the kit (session-inputs/), before any VM starts.
: "${VP_CLONE:=$HOME/.hermes/cache/scratch/vis8/check/vp}"
: "${VP_PIN:=014e0e7a56ee8e597c2cab8175233f74edd9b856}"
: "${CV_PY:=/usr/bin/python3}"
