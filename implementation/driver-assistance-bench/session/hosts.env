# The three bench hosts of INC-DRIVING-002, sourced by da_session.sh. No address is set here: the session reads every
# internal IP from gcloud at run time (D5 may move the hosts). Every value can be overridden from the
# environment. Names, projects, zones and machine types as listed by gcloud on 2026-11-18 (read only).
# Prices are EUR per hour of the running VM (Spot, europe-west4 catalogue read of 2026-11-15/16); disks are not
# counted. Re-price before quoting a cost to the owner.

: "${GCLOUD_CONFIGURATION:=de4sdv-gcp}"

# simulator host: CARLA 1.0, the world side and the chase recorder (g4-standard-48, RTX PRO 6000, Spot)
: "${SIM_VM:=de4sdv-probe-g4-carla}"
: "${SIM_PROJECT:=de4sdv-carla-d19a}"
: "${SIM_ZONE:=europe-west4-a}"
: "${SIM_EUR_H:=1.887}"
# 1: every ssh and scp to the simulator host goes through IAP (--tunnel-through-iap). Owner decision D5 of 2026-11-18,
# applied: the G4 is on carla-net (subnet carla-europe-west4), which allows SSH only from Google's IAP range
# 35.235.240.0/20 and CARLA's tcp 2000-2002 only from the S-CORE host's reserved 10.164.0.20/32; its external IP
# serves egress only. 0: direct SSH over the external IP (the default network before D5).
: "${SIM_SSH_IAP:=1}"

# S-CORE host: the candidate, the identity recorder, the actuation adapter, gatewayd, someipd (g2-standard-8, L4, Spot)
: "${SCORE_VM:=de4sdv-probe-da8-carla}"
: "${SCORE_PROJECT:=project-f2215f73-3d53-48a7-895}"
: "${SCORE_ZONE:=europe-west4-a}"
: "${SCORE_EUR_H:=0.483}"

# guest host: the SDV Core VM and the IVI VM under Cuttlefish (n2-standard-16, Spot). Protected: a session starts it
# only with --owner-ok-guest-host, and stops its guests with cvd stop before the host.
: "${GUEST_VM:=de4sdv-aaos-build}"
: "${GUEST_PROJECT:=project-f2215f73-3d53-48a7-895}"
: "${GUEST_ZONE:=europe-west4-a}"
: "${GUEST_EUR_H:=0.2713}"

# Cost caps per session kind, EUR (proposal: about twice the expected cost, see README "Durations and costs")
: "${CAP_EUR_P10_1:=2.00}"
: "${CAP_EUR_P10_3:=3.50}"
: "${CAP_EUR_P10_2:=6.00}"
