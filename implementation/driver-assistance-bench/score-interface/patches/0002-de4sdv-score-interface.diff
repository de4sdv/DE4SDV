+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// A clean exit from the main loop on SIGTERM, the signal the Launch Manager stops a process with. At the pin only
+// video mode leaves the loop (vision_pilot.cpp:120); with this flag the loop breaks and upstream's shutdown after
+// it runs, Rerun::shutdown() among it (vision_pilot.cpp:189). The handler only sets a flag.
+#pragma once
+
+namespace de4sdv::score_interface {
+
+// Installs the SIGTERM handler. Returns false if sigaction fails.
+bool InstallStopHandler();
+
+// True once SIGTERM arrived after InstallStopHandler(). Async-signal-safe to set, cheap to read.
+bool StopRequested();
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/adapters.cpp b/VisionPilot/modules/de4sdv/score_interface/src/adapters.cpp
new file mode 100644
index 00000000..4f032894
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/src/adapters.cpp
@@ -0,0 +1,111 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+// See score_camera_interface.hpp, score_vehicle_interface.hpp and score_warning_request_publisher.hpp.
+#include <algorithm>
+#include <cstdio>
+#include <string>
+
+#include "de4sdv/score_interface/score_camera_interface.hpp"
+#include "de4sdv/score_interface/score_vehicle_interface.hpp"
+#include "de4sdv/score_interface/score_warning_request_publisher.hpp"
+
+namespace de4sdv::score_interface {
+
+namespace {
+
+std::string ImageLine(const char* kind, std::uint64_t frame, double sim_time_s) {
+  char sim[32];
+  std::snprintf(sim, sizeof sim, "%.17g", sim_time_s);
+  return std::string("{\"kind\":\"") + kind + "\",\"frame\":" + std::to_string(frame) + ",\"sim_s\":" + sim +
+         ",\"mono_ns\":" + std::to_string(MonotonicNs()) + "}";
+}
+
+}  // namespace
+
+// ── SCORECameraInterface (MAP-DRIVING-DA-CAMERA-IMAGE) ──────────────────────────────────────────────────────────
+
+ScoreCameraInterface::ScoreCameraInterface(PassClock* clock, LineLog log) : clock_(clock), log_(std::move(log)) {}
+
+void ScoreCameraInterface::OnImage(const CameraImageView& image) {
+  if (image.width <= 0 || image.height <= 0) {
+    conversion_errors_.fetch_add(1);
+    return;
+  }
+  Frame f;
+  f.bgr.create(image.height, image.width, CV_8UC3);  // continuous
+  if (!ConvertBgraToBgr(image, f.bgr.data, f.bgr.total() * f.bgr.elemSize())) {
+    conversion_errors_.fetch_add(1);
+    if (log_) log_(ImageLine("error.camera_image", image.frame, image.sim_time_s));
+    return;
+  }
+  f.frame = image.frame;
+  f.sim_time_s = image.sim_time_s;
+  width_.store(static_cast<std::uint32_t>(image.width));
+  height_.store(static_cast<std::uint32_t>(image.height));
+  if (log_) log_(ImageLine("in.camera_image", image.frame, image.sim_time_s));
+  Frame replaced;
+  if (slot_.Put(std::move(f), &replaced) && log_) {
+    log_(ImageLine("drop.camera_image", replaced.frame, replaced.sim_time_s));
+  }
+}
+
+cv::Mat ScoreCameraInterface::get_latest_frame() {
+  Frame f;
+  if (!slot_.Take(&f)) return cv::Mat();
+  clock_->valid = true;  // the capture time of this pass (loop thread only)
+  clock_->capture_time_s = f.sim_time_s;
+  clock_->frame = f.frame;
+  handed_on_.fetch_add(1);
+  if (log_) log_(ImageLine("pass.camera_image", f.frame, f.sim_time_s));
+  return f.bgr;
+}
+
+CameraStats ScoreCameraInterface::get_camera_stats() const {
+  CameraStats s{};
+  s.frames_captured = handed_on_.load();  // handed on to the loop
+  s.capture_errors = 0;
+  s.current_width = width_.load();
+  s.current_height = height_.load();
+  s.current_fps = 0.0;  // the simulator paces the images in simulation time
+  s.frames_received = slot_.received();
+  s.frames_dropped = slot_.dropped();
+  s.conversion_errors = conversion_errors_.load();
+  return s;
+}
+
+// ── SCOREVehicleInterface (MAP-DRIVING-DA-VEHICLE-SPEED, MAP-DRIVING-DA-COMMAND) ────────────────────────────────
+
+ScoreVehicleInterface::ScoreVehicleInterface(SpeedSource speed_source, DrivingCommandWriter* writer, LineLog log)
+    : speed_source_(std::move(speed_source)), writer_(writer), log_(std::move(log)) {}
+
+double ScoreVehicleInterface::read() {
+  EgoVelocity v;
+  if (!speed_source_ || !speed_source_(&v)) {
+    ++speed_unavailable_;
+    return 0.0;
+  }
+  const double speed = SpeedOf(v);
+  if (log_) {
+    char text[96];
+    std::snprintf(text, sizeof text, "\"speed_mps\":%.17g,\"sim_s\":%.17g", speed, v.sim_time_s);
+    log_(std::string("{\"kind\":\"in.vehicle_speed\",") + text + ",\"frame\":" + std::to_string(v.frame) +
+         ",\"mono_ns\":" + std::to_string(MonotonicNs()) + "}");
+  }
+  return speed;
+}
+
+void ScoreVehicleInterface::write(double steering, double acceleration) { writer_->Write(steering, acceleration); }
+
+// ── SCOREWarningRequestPublisher (MAP-DRIVING-DA-WARNING-REQUEST) ───────────────────────────────────────────────
+
+bool HoldsForwardCollisionWarningOrEmergencyBraking(const std::vector<Warning>& warnings) {
+  return std::any_of(warnings.begin(), warnings.end(),
+                     [](Warning w) { return w == Warning::FCW || w == Warning::AEB; });
+}
+
+ScoreWarningRequestPublisher::ScoreWarningRequestPublisher(WarningRequestWriter* writer) : writer_(writer) {}
+
+void ScoreWarningRequestPublisher::Publish(const Plan& plan) {
+  writer_->Write(HoldsForwardCollisionWarningOrEmergencyBraking(plan.warnings));
+}
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/carla_client.cpp b/VisionPilot/modules/de4sdv/score_interface/src/carla_client.cpp
new file mode 100644
index 00000000..5f7bd27f
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/src/carla_client.cpp
@@ -0,0 +1,154 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// The CARLA 1.0 client behind seams.hpp (MakeCarlaClient), the one C++20 unit of the module: the client library of
+// CARLA 1.0 builds as C++20, so the readiness probe of 2026-11-15 compiled only the unit that calls it as C++20 and
+// the rest of the process as C++17. NOT COMPILED on the DE4SDV host: it needs the CARLA 1.0 client headers and
+// libraries, which only the S-CORE Bazel build (brief item B2) provides. The calls follow that probe's client unit
+// and the closed-loop driving bench's CARLA source.
+//
+// The world side spawns the hero and its front camera and ticks the world. This client only reads: it never spawns,
+// ticks, sets settings or controls anything (the actuation adapter applies the control).
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <carla/client/Actor.h>
+#include <carla/client/ActorList.h>
+#include <carla/client/Client.h>
+#include <carla/client/Sensor.h>
+#include <carla/client/World.h>
+#include <carla/client/WorldSnapshot.h>
+#include <carla/sensor/data/Image.h>
+
+#include "de4sdv/score_interface/seams.hpp"
+
+namespace de4sdv::score_interface {
+
+namespace {
+
+namespace cc = carla::client;
+
+std::string RoleOf(const cc::Actor& actor) {
+  for (const auto& attribute : actor.GetAttributes()) {
+    if (attribute.GetId() == "role_name") return attribute.GetValue();
+  }
+  return {};
+}
+
+class CarlaClient : public SimulatorClient {
+ public:
+  explicit CarlaClient(CarlaSettings settings) : settings_(std::move(settings)) {}
+  ~CarlaClient() override { Stop(); }
+
+  bool Attach(std::string* error) override {
+    try {
+      client_ = std::make_unique<cc::Client>(settings_.host, static_cast<std::uint16_t>(settings_.port));
+      client_->SetTimeout(std::chrono::milliseconds(static_cast<long>(settings_.timeout_s * 1000.0)));
+      world_ = std::make_unique<cc::World>(client_->GetWorld());
+      const auto deadline = std::chrono::steady_clock::now() +
+                            std::chrono::milliseconds(static_cast<long>(settings_.attach_timeout_s * 1000.0));
+      for (;;) {
+        carla::SharedPtr<cc::Actor> hero;
+        carla::SharedPtr<cc::Actor> camera;
+        const auto actors = world_->GetActors();
+        for (auto it = actors->begin(); it != actors->end(); ++it) {
+          const carla::SharedPtr<cc::Actor> actor = *it;
+          const std::string role = RoleOf(*actor);
+          if (role == settings_.hero_role && actor->GetTypeId().rfind("vehicle.", 0) == 0) hero = actor;
+          if (role == settings_.camera_role && actor->GetTypeId() == "sensor.camera.rgb") camera = actor;
+        }
+        if (hero && camera) {
+          if (camera->GetParent() == nullptr || camera->GetParent()->GetId() != hero->GetId()) {
+            *error = "the camera '" + settings_.camera_role + "' is not attached to the hero";
+            return false;
+          }
+          hero_id_ = hero->GetId();
+          camera_ = std::static_pointer_cast<cc::Sensor>(camera);
+          return true;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+          *error = "no hero '" + settings_.hero_role + "' with a camera '" + settings_.camera_role + "'";
+          return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+      }
+    } catch (const std::exception& e) {
+      *error = std::string("CARLA client: ") + e.what();
+      return false;
+    }
+  }
+
+  bool Start(ImageHandler on_image, std::string* error) override {
+    if (!camera_) {
+      *error = "Start before Attach";
+      return false;
+    }
+    handler_ = std::move(on_image);
+    running_.store(true);
+    try {
+      camera_->Listen([this](auto data) {
+        if (!running_.load()) return;
+        const auto image = std::static_pointer_cast<carla::sensor::data::Image>(data);
+        CameraImageView view;
+        view.frame = image->GetFrame();
+        view.sim_time_s = image->GetTimestamp();  // simulation s of the world snapshot the image was rendered in
+        view.width = static_cast<int>(image->GetWidth());
+        view.height = static_cast<int>(image->GetHeight());
+        view.row_bytes = static_cast<std::size_t>(image->GetWidth()) * sizeof(carla::sensor::data::Color);
+        view.bgra = reinterpret_cast<const std::uint8_t*>(image->data());  // Color is b, g, r, a
+        handler_(view);
+      });
+    } catch (const std::exception& e) {
+      *error = std::string("CARLA client: ") + e.what();
+      return false;
+    }
+    return true;
+  }
+
+  bool NewestEgoVelocity(EgoVelocity* out) override {
+    if (!world_) return false;
+    try {
+      const cc::WorldSnapshot snapshot = world_->GetSnapshot();  // the newest snapshot the client holds
+      const auto hero = snapshot.Find(hero_id_);
+      if (!hero) return false;
+      out->frame = snapshot.GetFrame();
+      out->sim_time_s = snapshot.GetTimestamp().elapsed_seconds;
+      out->x = hero->velocity.x;
+      out->y = hero->velocity.y;
+      out->z = hero->velocity.z;
+      return true;
+    } catch (const std::exception&) {
+      return false;
+    }
+  }
+
+  void Stop() override {
+    running_.store(false);
+    try {
+      if (camera_ && camera_->IsListening()) camera_->Stop();
+    } catch (const std::exception&) {
+      // the server may be gone at shutdown
+    }
+  }
+
+ private:
+  CarlaSettings settings_;
+  std::unique_ptr<cc::Client> client_;
+  std::unique_ptr<cc::World> world_;
+  carla::SharedPtr<cc::Sensor> camera_;
+  carla::ActorId hero_id_ = 0;
+  ImageHandler handler_;
+  std::atomic<bool> running_{false};
+};
+
+}  // namespace
+
+std::unique_ptr<SimulatorClient> MakeCarlaClient(const CarlaSettings& settings) {
+  return std::make_unique<CarlaClient>(settings);
+}
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/core.cpp b/VisionPilot/modules/de4sdv/score_interface/src/core.cpp
new file mode 100644
index 00000000..592ce377
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/src/core.cpp
@@ -0,0 +1,204 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot). See core.hpp.
+#include "de4sdv/score_interface/core.hpp"
+
+#include <time.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <utility>
+
+namespace de4sdv::score_interface {
+
+namespace da = driver_assistance;
+
+namespace {
+
+constexpr double kPi = 3.14159265358979323846;
+
+std::int64_t ClockNs(clockid_t id) {
+  timespec ts{};
+  clock_gettime(id, &ts);
+  return static_cast<std::int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+
+// A double as the shortest text that reads back to the same value.
+std::string Number(double v) {
+  char buf[32];
+  for (int precision = 15; precision <= 17; ++precision) {
+    std::snprintf(buf, sizeof buf, "%.*g", precision, v);
+    if (std::strtod(buf, nullptr) == v) break;
+  }
+  return buf;
+}
+
+bool TerminatedHex(const char* text, std::size_t capacity, std::size_t digits) {
+  if (std::memchr(text, '\0', capacity) == nullptr) return false;
+  if (std::strlen(text) != digits) return false;
+  for (std::size_t i = 0; i < digits; ++i) {
+    const char c = text[i];
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+std::int64_t MonotonicNs() { return ClockNs(CLOCK_MONOTONIC); }
+std::int64_t RealtimeNs() { return ClockNs(CLOCK_REALTIME); }
+
+bool ConvertBgraToBgr(const CameraImageView& image, std::uint8_t* dst, std::size_t dst_bytes) {
+  if (image.bgra == nullptr || dst == nullptr || image.width <= 0 || image.height <= 0) return false;
+  const std::size_t width = static_cast<std::size_t>(image.width);
+  const std::size_t height = static_cast<std::size_t>(image.height);
+  if (image.row_bytes < 4 * width) return false;
+  if (dst_bytes < 3 * width * height) return false;
+  for (std::size_t y = 0; y < height; ++y) {
+    const std::uint8_t* s = image.bgra + y * image.row_bytes;
+    std::uint8_t* d = dst + y * 3 * width;
+    for (std::size_t x = 0; x < width; ++x, s += 4, d += 3) {
+      d[0] = s[0];
+      d[1] = s[1];
+      d[2] = s[2];
+    }
+  }
+  return true;
+}
+
+double SpeedOf(const EgoVelocity& v) { return std::sqrt(v.x * v.x + v.y * v.y + v.z * v.z); }
+
+float SteeringAngleDegrees(double steering_rad) {
+  return static_cast<float>(-steering_rad * 180.0 / kPi);  // MAP-DRIVING-DA-COMMAND
+}
+
+da::DrivingCommandEventPayload MakeDrivingCommand(double steering_rad, double acceleration, double issue_time_s,
+                                                  std::uint32_t sequence_count) {
+  da::DrivingCommandEventPayload p{};
+  p.acceleration = static_cast<float>(acceleration);  // unchanged (MAP-DRIVING-DA-COMMAND)
+  p.steeringAngle = SteeringAngleDegrees(steering_rad);
+  p.issueTime = issue_time_s;
+  p.sequenceCount = sequence_count;
+  p.checkValue = da::DrivingCommandCheckValue(p);
+  return p;
+}
+
+bool WellFormedCandidateRecord(const da::CandidateRecordEventPayload& r) {
+  return TerminatedHex(r.recordSha256, sizeof r.recordSha256, 64) &&
+         TerminatedHex(r.upstreamRevision, sizeof r.upstreamRevision, 40) && r.diffBytes > 0u &&
+         std::memchr(r.recordPath, '\0', sizeof r.recordPath) != nullptr && r.recordPath[0] != '\0';
+}
+
+CandidateRecordGate::CandidateRecordGate(CandidateRecordSource* source, LineLog log)
+    : source_(source), log_(std::move(log)) {}
+
+bool CandidateRecordGate::Open() {
+  if (open_) return true;
+  da::CandidateRecordEventPayload record{};
+  if (source_ == nullptr || !source_->TakeNewest(&record)) return false;
+  const bool good = WellFormedCandidateRecord(record);
+  if (!good) ++rejected_;
+  if (log_) {
+    // Only the well-formed record's strings are printed; a malformed one may lack its terminator.
+    std::string line = "{\"kind\":\"in.candidate_record\",\"accepted\":";
+    line += good ? "true" : "false";
+    if (good) {
+      line += ",\"recordSha256\":\"" + std::string(record.recordSha256) + "\",\"upstreamRevision\":\"" +
+              std::string(record.upstreamRevision) + "\",\"diffBytes\":" + std::to_string(record.diffBytes);
+    }
+    line += ",\"mono_ns\":" + std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}";
+    log_(line);
+  }
+  open_ = good;
+  return open_;
+}
+
+DrivingCommandWriter::DrivingCommandWriter(DrivingCommandSink* sink, CandidateRecordGate* gate,
+                                           const PassClock* clock, LineLog log)
+    : sink_(sink), gate_(gate), clock_(clock), log_(std::move(log)) {}
+
+bool DrivingCommandWriter::Write(double steering_rad, double acceleration) {
+  if (!gate_->Open()) {  // REQ-DRIVING-044: nothing before the record has arrived
+    ++counters_.withheld_before_record;
+    return false;
+  }
+  if (!clock_->valid) {
+    ++counters_.withheld_without_capture_time;
+    return false;
+  }
+  const da::DrivingCommandEventPayload p =
+      MakeDrivingCommand(steering_rad, acceleration, clock_->capture_time_s, ++last_sequence_);
+  const bool sent = sink_->Send(p);
+  if (sent) {
+    ++counters_.sent;
+  } else {
+    ++counters_.send_failed;
+  }
+  if (log_) {
+    char crc[11];
+    std::snprintf(crc, sizeof crc, "0x%08x", p.checkValue);
+    log_(std::string("{\"kind\":\"out.driving_command\",\"seq\":") + std::to_string(p.sequenceCount) +
+         ",\"crc\":\"" + crc + "\",\"issueTime_sim_s\":" + Number(p.issueTime) +
+         ",\"frame\":" + std::to_string(clock_->frame) + ",\"acceleration\":" + Number(p.acceleration) +
+         ",\"steeringAngle_deg\":" + Number(p.steeringAngle) + ",\"sent\":" + (sent ? "true" : "false") +
+         ",\"mono_ns\":" + std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+  }
+  return sent;
+}
+
+WarningRequestWriter::WarningRequestWriter(WarningRequestSink* sink, const PassClock* clock, LineLog log)
+    : sink_(sink), clock_(clock), log_(std::move(log)) {}
+
+bool WarningRequestWriter::Write(bool requested) {
+  std::uint8_t bytes[da::kWarningRequestSomeipSize];
+  if (!clock_->valid || !da::EncodeWarningRequestSomeip({requested, clock_->capture_time_s}, bytes)) {
+    ++counters_.not_encodable;
+    return false;
+  }
+  const bool sent = sink_->Send(bytes, sizeof bytes);
+  if (sent) {
+    ++counters_.sent;
+    if (requested) ++counters_.requested;
+  } else {
+    ++counters_.send_failed;
+  }
+  if (log_) {
+    char hex[2 * sizeof bytes + 1];
+    for (std::size_t i = 0; i < sizeof bytes; ++i) std::snprintf(hex + 2 * i, 3, "%02x", bytes[i]);
+    log_(std::string("{\"kind\":\"out.warning_request\",\"requested\":") + (requested ? "true" : "false") +
+         ",\"issueTime_sim_s\":" + Number(clock_->capture_time_s) + ",\"frame\":" + std::to_string(clock_->frame) +
+         ",\"bytes\":\"" + hex + "\",\"sent\":" + (sent ? "true" : "false") +
+         ",\"mono_ns\":" + std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+  }
+  return sent;
+}
+
+CycleSupervision::CycleSupervision(LifecycleClient* client, LineLog log) : client_(client), log_(std::move(log)) {}
+
+void CycleSupervision::CycleCompleted(bool stop_requested) {
+  if (stop_requested) stopped_ = true;
+  if (client_ == nullptr || stopped_) return;
+  if (!started_) {
+    started_ = true;
+    running_reported_ = client_->ReportRunning();
+    if (log_) {
+      log_(std::string(running_reported_ ? "{\"kind\":\"supervision.start\"" : "{\"kind\":\"error.supervision\",\"what\":\"report_running failed\"") +
+           ",\"mono_ns\":" + std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+    }
+  }
+  client_->ReportAlive();
+  ++alive_reported_;
+}
+
+void CycleSupervision::Stop() {
+  stopped_ = true;
+  if (client_ == nullptr || stop_logged_) return;
+  stop_logged_ = true;
+  if (log_) {
+    log_("{\"kind\":\"supervision.stop\",\"alive_reported\":" + std::to_string(alive_reported_) +
+         ",\"mono_ns\":" + std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+  }
+}
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/lifecycle_bindings.cpp b/VisionPilot/modules/de4sdv/score_interface/src/lifecycle_bindings.cpp
