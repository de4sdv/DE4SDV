diff --git a/VisionPilot/modules/de4sdv/score_interface/CMakeLists.txt b/VisionPilot/modules/de4sdv/score_interface/CMakeLists.txt
new file mode 100644
index 00000000..e9797f9c
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/CMakeLists.txt
@@ -0,0 +1,48 @@
+# DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+# Built only with -DENABLE_SCORE_INTERFACE=ON. The S-CORE build of the bench is Bazel (brief item B2); this file lets
+# upstream's CMake build compile the portable part of the module.
+#
+#   DE4SDV_DA_INTERFACES_INCLUDE_DIR  the bench's interfaces/include (de4sdv/driver_assistance/payloads.h), used in
+#                                     place, never copied
+#   DE4SDV_SCORE_BINDINGS             a library or target that defines MakeLolaPorts, MakeCarlaClient and
+#                                     MakeLifecycleClient (seams.hpp): src/lola_bindings.cpp, src/carla_client.cpp and
+#                                     src/lifecycle_bindings.cpp need mw::com, the CARLA 1.0 client and S-CORE
+#                                     Lifecycle, which only the Bazel build provides
+cmake_minimum_required(VERSION 3.22.1)
+
+set(DE4SDV_DA_INTERFACES_INCLUDE_DIR "" CACHE PATH "DE4SDV driver-assistance bench interfaces/include")
+set(DE4SDV_SCORE_BINDINGS "" CACHE STRING "library defining MakeLolaPorts, MakeCarlaClient and MakeLifecycleClient")
+if(NOT EXISTS "${DE4SDV_DA_INTERFACES_INCLUDE_DIR}/de4sdv/driver_assistance/payloads.h")
+    message(FATAL_ERROR "ENABLE_SCORE_INTERFACE needs DE4SDV_DA_INTERFACES_INCLUDE_DIR with "
+                        "de4sdv/driver_assistance/payloads.h")
+endif()
+if(NOT DE4SDV_SCORE_BINDINGS)
+    message(FATAL_ERROR "ENABLE_SCORE_INTERFACE needs DE4SDV_SCORE_BINDINGS")
+endif()
+
+find_package(OpenCV REQUIRED COMPONENTS core)
+
+add_library(de4sdv_score_interface
+        src/adapters.cpp
+        src/core.cpp
+        src/score_interface.cpp
+        src/settings.cpp
+        src/stop_signal.cpp
+)
+
+target_include_directories(de4sdv_score_interface
+        PUBLIC
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+        ${DE4SDV_DA_INTERFACES_INCLUDE_DIR}
+)
+
+target_link_libraries(de4sdv_score_interface
+        PUBLIC
+        common
+        camera_interface
+        vehicle_interface
+        opencv_core
+        ${DE4SDV_SCORE_BINDINGS}
+)
+
+target_compile_features(de4sdv_score_interface PUBLIC cxx_std_17)
diff --git a/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/core.hpp b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/core.hpp
new file mode 100644
index 00000000..10fc0ddd
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/core.hpp
@@ -0,0 +1,183 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// The module's logic, free of upstream types, OpenCV, mw::com and CARLA. The adapters on upstream's seams
+// (score_camera_interface.hpp, score_vehicle_interface.hpp, score_warning_request_publisher.hpp) delegate to it.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <utility>
+
+#include "de4sdv/driver_assistance/payloads.h"
+#include "de4sdv/score_interface/seams.hpp"
+
+namespace de4sdv::score_interface {
+
+// One JSON object per line; empty when the run keeps no event log.
+using LineLog = std::function<void(const std::string&)>;
+
+// The capture time of the frame of the current pass of the loop (MAP-DRIVING-DA-CAMERA-IMAGE: "the module keeps its
+// capture time ... and the vehicle interface and the warning request publisher read it in the same pass"). Only the
+// loop thread touches it: the camera interface sets it when get_latest_frame() hands on an image, the vehicle
+// interface and the warning request publisher read it later in that pass.
+struct PassClock {
+  bool valid = false;
+  double capture_time_s = 0.0;  // simulation s
+  std::uint64_t frame = 0;      // the simulator's frame number of the image
+};
+
+// A single slot that keeps only the newest item. Put() replaces an unread item and counts it as dropped, as
+// upstream's ROS 2 camera interface counts a replaced frame (camera_ros2_interface.cpp:95-100). Put() runs on the
+// producer's thread, Take() on the loop's.
+template <typename T>
+class LatestSlot {
+ public:
+  // Returns true when the item replaced an unread one; that one goes to *replaced if given.
+  bool Put(T item, T* replaced = nullptr) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++received_;
+    const bool dropped = full_;
+    if (dropped) {
+      ++dropped_;
+      if (replaced != nullptr) *replaced = std::move(item_);
+    }
+    item_ = std::move(item);
+    full_ = true;
+    return dropped;
+  }
+  bool Take(T* out) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!full_) return false;
+    *out = std::move(item_);
+    item_ = T{};
+    full_ = false;
+    return true;
+  }
+  std::uint64_t received() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return received_;
+  }
+  std::uint64_t dropped() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return dropped_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  T item_{};
+  bool full_ = false;
+  std::uint64_t received_ = 0;
+  std::uint64_t dropped_ = 0;
+};
+
+// BGRA to BGR, no resampling (MAP-DRIVING-DA-CAMERA-IMAGE transformationRule). dst holds 3 * width * height bytes,
+// rows without padding. Returns false, writing nothing, for a size it cannot convert.
+bool ConvertBgraToBgr(const CameraImageView& image, std::uint8_t* dst, std::size_t dst_bytes);
+
+// |velocity| in m/s, the value VehicleInterface::read() returns (MAP-DRIVING-DA-VEHICLE-SPEED: the planner takes
+// m/s; the km/h value is the VSS typing at the port).
+double SpeedOf(const EgoVelocity& velocity);
+
+// steeringAngle = -steering[1] * 180 / pi (MAP-DRIVING-DA-COMMAND): the candidate's steering is a tyre angle in rad
+// in the sign of CARLA's steer, positive to the right; the VSS steering angle is in degrees, positive to the left.
+float SteeringAngleDegrees(double steering_rad);
+
+// One driving command with its check value (payloads.h, DrivingCommandCheckValue).
+driver_assistance::DrivingCommandEventPayload MakeDrivingCommand(double steering_rad, double acceleration,
+                                                                 double issue_time_s, std::uint32_t sequence_count);
+
+// The gate of REQ-DRIVING-044: open once a well-formed candidate record has arrived on its mw::com subscription,
+// and open from then on. Well-formed: NUL-terminated strings, 64 hex digits of SHA-256, 40 hex digits of revision,
+// a difference of more than 0 bytes (payloads.h: "never 0").
+class CandidateRecordGate {
+ public:
+  CandidateRecordGate(CandidateRecordSource* source, LineLog log);
+  bool Open();  // polls the source while closed
+  std::uint64_t rejected() const { return rejected_; }
+
+ private:
+  CandidateRecordSource* source_;
+  LineLog log_;
+  bool open_ = false;
+  std::uint64_t rejected_ = 0;
+};
+
+bool WellFormedCandidateRecord(const driver_assistance::CandidateRecordEventPayload& record);
+
+// The write of the vehicle interface (MAP-DRIVING-DA-COMMAND): adds issueTime (the capture time of the pass), a
+// sequence count from 1 in each run and the check value, and sends nothing before the record has arrived.
+class DrivingCommandWriter {
+ public:
+  struct Counters {
+    std::uint64_t sent = 0;
+    std::uint64_t send_failed = 0;               // the sequence count was used: the adapter sees a loss
+    std::uint64_t withheld_before_record = 0;
+    std::uint64_t withheld_without_capture_time = 0;
+  };
+  DrivingCommandWriter(DrivingCommandSink* sink, CandidateRecordGate* gate, const PassClock* clock, LineLog log);
+  // Returns true when a command was handed to the sink and the sink accepted it.
+  bool Write(double steering_rad, double acceleration);
+  const Counters& counters() const { return counters_; }
+
+ private:
+  DrivingCommandSink* sink_;
+  CandidateRecordGate* gate_;
+  const PassClock* clock_;
+  LineLog log_;
+  std::uint32_t last_sequence_ = 0;
+  Counters counters_{};
+};
+
+// The warning request publisher's core (MAP-DRIVING-DA-WARNING-REQUEST): one event per plan, issueTime the capture
+// time of the pass, the 8 bytes of EncodeWarningRequestSomeip.
+class WarningRequestWriter {
+ public:
+  struct Counters {
+    std::uint64_t sent = 0;
+    std::uint64_t requested = 0;  // events sent with requested = true
+    std::uint64_t send_failed = 0;
+    std::uint64_t not_encodable = 0;  // no capture time, or one EncodeWarningRequestSomeip refuses
+  };
+  WarningRequestWriter(WarningRequestSink* sink, const PassClock* clock, LineLog log);
+  bool Write(bool requested);
+  const Counters& counters() const { return counters_; }
+
+ private:
+  WarningRequestSink* sink_;
+  const PassClock* clock_;
+  LineLog log_;
+  Counters counters_{};
+};
+
+// The alive supervision of the candidate's process (the supervision decision of 2026-11-18). The loop calls
+// CycleCompleted() once at the end of each pass that handled a frame. The first such pass reports the process running
+// before its alive notification, so the Launch Manager starts supervising after the network sessions, the first
+// frame and the first inference, which its ready timeout covers instead. Every pass gives one alive notification.
+// Once a stop is requested, no notification follows. A null client: no supervision, nothing is reported.
+class CycleSupervision {
+ public:
+  CycleSupervision(LifecycleClient* client, LineLog log);
+  void CycleCompleted(bool stop_requested);
+  // Ends the supervision on the module's side: no notification after it, and one supervision.stop line.
+  void Stop();
+  std::uint64_t alive_reported() const { return alive_reported_; }
+  bool running_reported() const { return running_reported_; }
+
+ private:
+  LifecycleClient* client_;
+  LineLog log_;
+  bool started_ = false;
+  bool running_reported_ = false;
+  bool stopped_ = false;
+  bool stop_logged_ = false;
+  std::uint64_t alive_reported_ = 0;
+};
+
+// Monotonic and real time of the host, ns, for the event log (the path share of REQ-DRIVING-042 is wall-clock).
+std::int64_t MonotonicNs();
+std::int64_t RealtimeNs();
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_camera_interface.hpp b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_camera_interface.hpp
new file mode 100644
index 00000000..9afdd787
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_camera_interface.hpp
@@ -0,0 +1,51 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// SCORECameraInterface of the model: upstream's camera seam (camera_interface.hpp:18, get_latest_frame) fed by the
+// CARLA 1.0 client (MAP-DRIVING-DA-CAMERA-IMAGE). The client's thread calls OnImage(); the module converts the
+// image from BGRA to BGR there and keeps only the newest one. get_latest_frame() hands it on to the loop
+// (vision_pilot.cpp:117) and sets the pass's capture time, the simulation time of the world snapshot the image was
+// rendered in. Every image replaced unread is counted and logged as dropped.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include <camera_interface/camera_interface.hpp>
+#include <opencv2/core/mat.hpp>
+
+#include "de4sdv/score_interface/core.hpp"
+#include "de4sdv/score_interface/seams.hpp"
+
+namespace de4sdv::score_interface {
+
+class ScoreCameraInterface : public camera_interface::CameraInterface {
+ public:
+  ScoreCameraInterface(PassClock* clock, LineLog log);
+  ~ScoreCameraInterface() override = default;
+
+  // On the simulator client's thread.
+  void OnImage(const CameraImageView& image);
+  void SetOpen(bool open) { open_.store(open); }
+
+  bool is_device_open() const override { return open_.load(); }
+  // An empty Mat when no new image arrived since the last call; the pass clock is left as it is then.
+  cv::Mat get_latest_frame() override;
+  CameraStats get_camera_stats() const override;
+
+ private:
+  struct Frame {
+    cv::Mat bgr;
+    std::uint64_t frame = 0;
+    double sim_time_s = 0.0;
+  };
+  PassClock* clock_;
+  LineLog log_;
+  LatestSlot<Frame> slot_;
+  std::atomic<bool> open_{false};
+  std::atomic<std::uint64_t> handed_on_{0};
+  std::atomic<std::uint64_t> conversion_errors_{0};
+  std::atomic<std::uint32_t> width_{0};
+  std::atomic<std::uint32_t> height_{0};
+};
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_interface.hpp b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_interface.hpp
new file mode 100644
index 00000000..b6ce0f56
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/include/de4sdv/score_interface/score_interface.hpp
@@ -0,0 +1,74 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// The module as the loop sees it: the S-CORE branch beside vision_pilot.cpp:59-79 calls Start() when
+// source.mode = score, takes camera() and vehicle() as its two interfaces, installs the SIGTERM handler, the
+// loop hands each plan to warning_request_publisher() after the write at vision_pilot.cpp:174, and it calls
+// CycleCompleted() at the end of each pass that handled a frame (the Launch Manager's alive supervision).
+//
+// Ownership: the object owns the simulator client, the mw::com ports and every module; camera() and vehicle() share
+// two of them. Destroy it after the loop: it stops the client first, then prints and logs the run's counters.
+#pragma once
+
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "de4sdv/score_interface/core.hpp"
+#include "de4sdv/score_interface/score_camera_interface.hpp"
+#include "de4sdv/score_interface/score_vehicle_interface.hpp"
+#include "de4sdv/score_interface/score_warning_request_publisher.hpp"
+#include "de4sdv/score_interface/seams.hpp"
+#include "de4sdv/score_interface/settings.hpp"
+
+namespace de4sdv::score_interface {
+
+class ScoreInterface {
+ public:
+  // Reads the settings (SettingsPath()), makes the mw::com ports, the CARLA client and the lifecycle client with the
+  // three factories of seams.hpp, attaches and starts. nullptr, with the reason on stderr, on any failure; a missing
+  // lifecycle client is no failure: the run is then unsupervised, and the log says so (supervision.off).
+  static std::unique_ptr<ScoreInterface> Start();
+  // The same from given parts; the unit tests pass fakes. lifecycle may be null, with off_reason for the log.
+  static std::unique_ptr<ScoreInterface> Start(const Settings& settings, MwComPorts ports,
+                                               std::unique_ptr<SimulatorClient> client,
+                                               std::unique_ptr<LifecycleClient> lifecycle,
+                                               const std::string& off_reason, std::string* error);
+  // Without a lifecycle client.
+  static std::unique_ptr<ScoreInterface> Start(const Settings& settings, MwComPorts ports,
+                                               std::unique_ptr<SimulatorClient> client, std::string* error);
+  ~ScoreInterface();
+  ScoreInterface(const ScoreInterface&) = delete;
+  ScoreInterface& operator=(const ScoreInterface&) = delete;
+
+  std::shared_ptr<ScoreCameraInterface> camera() const { return camera_; }
+  std::shared_ptr<ScoreVehicleInterface> vehicle() const { return vehicle_; }
+  ScoreWarningRequestPublisher& warning_request_publisher() { return *publisher_; }
+  // The end of a pass of the loop that handled a frame: one alive notification (CycleSupervision), none once SIGTERM
+  // has arrived.
+  void CycleCompleted();
+
+  // The run's counters as one JSON object.
+  std::string Summary() const;
+
+ private:
+  ScoreInterface() = default;
+  void Log(const std::string& line);
+
+  std::mutex log_mutex_;
+  std::FILE* log_file_ = nullptr;
+  LineLog log_;
+  PassClock clock_;
+  MwComPorts ports_;
+  std::unique_ptr<SimulatorClient> client_;
+  std::unique_ptr<CandidateRecordGate> gate_;
+  std::unique_ptr<DrivingCommandWriter> command_writer_;
+  std::unique_ptr<WarningRequestWriter> warning_writer_;
+  std::shared_ptr<ScoreCameraInterface> camera_;
+  std::shared_ptr<ScoreVehicleInterface> vehicle_;
+  std::unique_ptr<ScoreWarningRequestPublisher> publisher_;
