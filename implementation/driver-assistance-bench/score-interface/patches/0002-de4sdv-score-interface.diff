@@ -0,0 +1,54 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot). See seams.hpp.
+//
+// The lifecycle client on S-CORE Lifecycle v0.10.0 (eclipse-score/lifecycle 2afae116): report_running from
+// //score/launch_manager:lifecycle_cc and the Alive API from //score/launch_manager:alive_cc, in the pattern of
+// upstream's examples/c_supervised_app/main.c:42-58 (initialize, report running, report alive in the loop). Only the
+// S-CORE Bazel build compiles this unit (brief item B2); the host's tests replace it with a fake.
+//
+// The Launch Manager sets LCM_ALIVE_INTERFACE_PATH only for a component of type Reporting_And_Supervised or
+// State_Manager. Without it the process was not started as a supervised component: the factory returns nullptr and
+// the module runs unsupervised, which its log states (supervision.off).
+#include <cstdint>
+#include <cstdlib>
+#include <exception>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "de4sdv/score_interface/seams.hpp"
+#include "score/mw/lifecycle/alive.h"
+#include "score/mw/lifecycle/report_running.h"
+
+namespace de4sdv::score_interface {
+
+namespace {
+
+constexpr const char* kAliveInstance = "de4sdv/driver_assistance/vision_pilot";  // unused by Lifecycle v0.10.0
+
+class ScoreLifecycleClient final : public LifecycleClient {
+ public:
+  explicit ScoreLifecycleClient(std::unique_ptr<score::mw::lifecycle::Alive> alive) : alive_(std::move(alive)) {}
+  bool ReportRunning() override { return score_mw_lifecycle_report_running() == 0; }
+  void ReportAlive() override { alive_->ReportAlive(); }
+
+ private:
+  std::unique_ptr<score::mw::lifecycle::Alive> alive_;
+};
+
+}  // namespace
+
+std::unique_ptr<LifecycleClient> MakeLifecycleClient(std::string* reason) {
+  const char* path = std::getenv("LCM_ALIVE_INTERFACE_PATH");
+  if (path == nullptr || path[0] == '\0') {
+    *reason = "LCM_ALIVE_INTERFACE_PATH is unset: the Launch Manager did not start this process as a supervised component";
+    return nullptr;
+  }
+  try {
+    return std::make_unique<ScoreLifecycleClient>(std::make_unique<score::mw::lifecycle::Alive>(kAliveInstance));
+  } catch (const std::exception& e) {
+    *reason = std::string("the Alive instance failed: ") + e.what();
+    return nullptr;
+  }
+}
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/lola_bindings.cpp b/VisionPilot/modules/de4sdv/score_interface/src/lola_bindings.cpp
new file mode 100644
index 00000000..1bae2535
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/src/lola_bindings.cpp
@@ -0,0 +1,203 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot).
+//
+// The LoLa/mw::com bindings behind seams.hpp (MakeLolaPorts). NOT COMPILED on the DE4SDV host: it needs the S-CORE
+// Communication headers and library, which only the S-CORE Bazel build (brief item B2) provides. The calls follow the
+// API that the readiness probe of 2026-11-15 compiled (Communication 0.6.0) and the closed-loop driving bench's state
+// publisher.
+//
+// Events (interfaces/ICD.md; ids and the instance specifiers are bench proposals, the service ids live in the mw::com
+// configuration):
+//   de4sdv/driver_assistance/driving_command   skeleton, event "driving_command", DrivingCommandEventPayload
+//   de4sdv/driver_assistance/warning_request   skeleton, event "warning_request", the 8 SOME/IP bytes in a
+//                                              PreSerializedData sample for gatewayd (size = 8, data[0..8))
+//   de4sdv/driver_assistance/candidate_record  proxy, event "candidate_record", CandidateRecordEventPayload
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <type_traits>
+#include <utility>
+
+#include "de4sdv/driver_assistance/payloads.h"
+#include "de4sdv/score_interface/seams.hpp"
+#include "score/mw/com/runtime.h"
+#include "score/mw/com/types.h"
+#include "score/serializer/pre_serialized_data.h"
+
+namespace de4sdv::score_interface {
+
+namespace da = driver_assistance;
+
+namespace {
+
+// OPEN: the capacity of the warning-request sample. ICD.md fixes the 8 bytes, not the container; gatewayd's null
+// serializer reads a PreSerializedData sample, whose capacity must equal the gateway's max_message_size in the
+// gateway configuration (brief item B6). 2048 is the closed-loop driving bench's value.
+constexpr std::size_t kWarningRequestSampleCapacity = 2048;
+using WarningRequestSample = score::someip_gateway::serializer::PreSerializedData<kWarningRequestSampleCapacity>;
+static_assert(std::is_standard_layout_v<WarningRequestSample>);
+static_assert(da::kWarningRequestSomeipSize <= kWarningRequestSampleCapacity);
+
+// OPEN: the subscriber's max sample count (ICD.md gives none). The record is re-published every 1 s; one sample is
+// enough. The mw::com configuration's slots must allow it.
+constexpr std::size_t kRecordMaxSampleCount = 1;
+
+constexpr const char* kCommandSpecifier = "de4sdv/driver_assistance/driving_command";
+constexpr const char* kWarningSpecifier = "de4sdv/driver_assistance/warning_request";
+constexpr const char* kRecordSpecifier = "de4sdv/driver_assistance/candidate_record";
+
+template <typename Trait>
+struct DrivingCommandService : public Trait::Base {
+  using Trait::Base::Base;
+  typename Trait::template Event<da::DrivingCommandEventPayload> driving_command{*this, "driving_command"};
+};
+using DrivingCommandSkeleton = score::mw::com::AsSkeleton<DrivingCommandService>;
+
+template <typename Trait>
+struct WarningRequestService : public Trait::Base {
+  using Trait::Base::Base;
+  typename Trait::template Event<WarningRequestSample> warning_request{*this, "warning_request"};
+};
+using WarningRequestSkeleton = score::mw::com::AsSkeleton<WarningRequestService>;
+
+template <typename Trait>
+struct CandidateRecordService : public Trait::Base {
+  using Trait::Base::Base;
+  typename Trait::template Event<da::CandidateRecordEventPayload> candidate_record{*this, "candidate_record"};
+};
+using CandidateRecordProxy = score::mw::com::AsProxy<CandidateRecordService>;
+
+class LolaCommandSink : public DrivingCommandSink {
+ public:
+  explicit LolaCommandSink(DrivingCommandSkeleton skeleton) : skeleton_(std::move(skeleton)) {}
+  ~LolaCommandSink() override { skeleton_.StopOfferService(); }
+  bool Send(const da::DrivingCommandEventPayload& payload) override {
+    auto slot = skeleton_.driving_command.Allocate();
+    if (!slot.has_value()) return false;
+    auto sample = std::move(slot).value();
+    *sample = payload;
+    return skeleton_.driving_command.Send(std::move(sample)).has_value();
+  }
+
+ private:
+  DrivingCommandSkeleton skeleton_;
+};
+
+class LolaWarningSink : public WarningRequestSink {
+ public:
+  explicit LolaWarningSink(WarningRequestSkeleton skeleton) : skeleton_(std::move(skeleton)) {}
+  ~LolaWarningSink() override { skeleton_.StopOfferService(); }
+  bool Send(const std::uint8_t* bytes, std::size_t size) override {
+    if (size > kWarningRequestSampleCapacity) return false;
+    auto slot = skeleton_.warning_request.Allocate();
+    if (!slot.has_value()) return false;
+    auto sample = std::move(slot).value();
+    sample->size = size;  // gatewayd copies data[0..size) onto the SOME/IP payload, no prefix
+    std::memcpy(sample->data, bytes, size);
+    return skeleton_.warning_request.Send(std::move(sample)).has_value();
+  }
+
+ private:
+  WarningRequestSkeleton skeleton_;
+};
+
+// Finds the record service asynchronously; the loop thread creates the proxy and subscribes in TakeNewest(), as the
+// closed-loop bench's state publisher does, so every proxy call happens on one thread.
+class LolaRecordSource : public CandidateRecordSource {
+ public:
+  using HandleType = CandidateRecordProxy::HandleType;
+  ~LolaRecordSource() override {
+    if (find_handle_.has_value()) static_cast<void>(CandidateRecordProxy::StopFindService(find_handle_.value()));
+  }
+  bool StartFind(std::string* error) {
+    auto specifier = score::mw::com::InstanceSpecifier::Create(std::string{kRecordSpecifier});
+    if (!specifier.has_value()) {
+      *error = std::string("instance specifier ") + kRecordSpecifier;
+      return false;
+    }
+    auto started = CandidateRecordProxy::StartFindService(
+        [this](score::mw::com::ServiceHandleContainer<HandleType> handles, score::mw::com::FindServiceHandle) {
+          std::lock_guard<std::mutex> lock(mutex_);
+          if (handle_.has_value() || handles.empty()) return;
+          handle_.emplace(handles.front());
+        },
+        specifier.value());
+    if (!started.has_value()) {
+      *error = "StartFindService " + std::string(kRecordSpecifier);
+      return false;
+    }
+    find_handle_.emplace(started.value());
+    return true;
+  }
+  bool TakeNewest(da::CandidateRecordEventPayload* out) override {
+    if (!proxy_) {
+      std::optional<HandleType> handle;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        handle = handle_;
+      }
+      if (!handle.has_value()) return false;
+      auto created = CandidateRecordProxy::Create(handle.value());
+      if (!created.has_value()) return false;
+      proxy_ = std::make_unique<CandidateRecordProxy>(std::move(created).value());
+      if (!proxy_->candidate_record.Subscribe(kRecordMaxSampleCount).has_value()) {
+        proxy_.reset();
+        return false;
+      }
+    }
+    bool got = false;
+    static_cast<void>(proxy_->candidate_record.GetNewSamples(
+        [&](score::mw::com::SamplePtr<da::CandidateRecordEventPayload> sample) {
+          *out = *sample;
+          got = true;
+        },
+        kRecordMaxSampleCount));
+    return got;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::optional<HandleType> handle_;
+  std::optional<score::mw::com::FindServiceHandle> find_handle_;
+  std::unique_ptr<CandidateRecordProxy> proxy_;
+};
+
+template <typename Skeleton>
+std::optional<Skeleton> Offer(const char* specifier_text, std::string* error) {
+  auto specifier = score::mw::com::InstanceSpecifier::Create(std::string{specifier_text});
+  if (!specifier.has_value()) {
+    *error = std::string("instance specifier ") + specifier_text;
+    return std::nullopt;
+  }
+  auto created = Skeleton::Create(specifier.value());
+  if (!created.has_value()) {
+    *error = std::string("skeleton ") + specifier_text;
+    return std::nullopt;
+  }
+  Skeleton skeleton = std::move(created).value();
+  if (!skeleton.OfferService().has_value()) {
+    *error = std::string("OfferService ") + specifier_text;
+    return std::nullopt;
+  }
+  return std::optional<Skeleton>(std::move(skeleton));
+}
+
+}  // namespace
+
+MwComPorts MakeLolaPorts(const std::string& mw_com_config_path, std::string* error) {
+  score::mw::com::runtime::InitializeRuntime(score::mw::com::runtime::RuntimeConfiguration{mw_com_config_path});
+  MwComPorts ports;
+  auto command = Offer<DrivingCommandSkeleton>(kCommandSpecifier, error);
+  if (!command) return ports;
+  auto warning = Offer<WarningRequestSkeleton>(kWarningSpecifier, error);
+  if (!warning) return ports;
+  auto record = std::make_unique<LolaRecordSource>();
+  if (!record->StartFind(error)) return ports;
+  ports.command = std::make_unique<LolaCommandSink>(std::move(*command));
+  ports.warning = std::make_unique<LolaWarningSink>(std::move(*warning));
+  ports.record = std::move(record);
+  return ports;
+}
+
+}  // namespace de4sdv::score_interface
diff --git a/VisionPilot/modules/de4sdv/score_interface/src/score_interface.cpp b/VisionPilot/modules/de4sdv/score_interface/src/score_interface.cpp
new file mode 100644
index 00000000..386d5b27
--- /dev/null
+++ b/VisionPilot/modules/de4sdv/score_interface/src/score_interface.cpp
@@ -0,0 +1,154 @@
+// DE4SDV S-CORE interface for VisionPilot (INC-DRIVING-002, not part of upstream VisionPilot). See
+// score_interface.hpp.
+#include "de4sdv/score_interface/score_interface.hpp"
+
+#include <cstdio>
+#include <string>
+#include <utility>
+
+#include "de4sdv/score_interface/stop_signal.hpp"
+
+namespace de4sdv::score_interface {
+
+std::unique_ptr<ScoreInterface> ScoreInterface::Start() {
+  const std::string path = SettingsPath();
+  Settings settings;
+  std::string error;
+  if (!LoadSettings(path, &settings, &error)) {
+    std::fprintf(stderr, "[DE4SDV] S-CORE interface: %s\n", error.c_str());
+    return nullptr;
+  }
+  MwComPorts ports = MakeLolaPorts(settings.mw_com_config, &error);
+  if (!ports.command || !ports.warning || !ports.record) {
+    std::fprintf(stderr, "[DE4SDV] S-CORE interface: mw::com: %s\n", error.c_str());
+    return nullptr;
+  }
+  std::unique_ptr<SimulatorClient> client = MakeCarlaClient(settings.carla);
+  std::string off_reason;
+  std::unique_ptr<LifecycleClient> lifecycle = MakeLifecycleClient(&off_reason);
+  if (!lifecycle) std::fprintf(stderr, "[DE4SDV] S-CORE interface: unsupervised: %s\n", off_reason.c_str());
+  auto module = Start(settings, std::move(ports), std::move(client), std::move(lifecycle), off_reason, &error);
+  if (!module) std::fprintf(stderr, "[DE4SDV] S-CORE interface: %s\n", error.c_str());
+  return module;
+}
+
+std::unique_ptr<ScoreInterface> ScoreInterface::Start(const Settings& settings, MwComPorts ports,
+                                                      std::unique_ptr<SimulatorClient> client, std::string* error) {
+  return Start(settings, std::move(ports), std::move(client), nullptr, "no lifecycle client given", error);
+}
+
+namespace {
+
+// A reason as a JSON string body: quotes, backslashes and control characters escaped.
+std::string Escaped(const std::string& text) {
+  std::string out;
+  for (const char c : text) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+      out += c;
+    } else if (static_cast<unsigned char>(c) < 0x20) {
+      char buf[8];
+      std::snprintf(buf, sizeof buf, "\\u%04x", static_cast<unsigned>(static_cast<unsigned char>(c)));
+      out += buf;
+    } else {
+      out += c;
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+std::unique_ptr<ScoreInterface> ScoreInterface::Start(const Settings& settings, MwComPorts ports,
+                                                      std::unique_ptr<SimulatorClient> client,
+                                                      std::unique_ptr<LifecycleClient> lifecycle,
+                                                      const std::string& off_reason, std::string* error) {
+  if (!ports.command || !ports.warning || !ports.record || !client) {
+    *error = "a port or the simulator client is missing";
+    return nullptr;
+  }
+  std::unique_ptr<ScoreInterface> m(new ScoreInterface());
+  if (!settings.log_path.empty()) {
+    m->log_file_ = std::fopen(settings.log_path.c_str(), "a");
+    if (m->log_file_ == nullptr) {
+      *error = "cannot open log.path " + settings.log_path;
+      return nullptr;
+    }
+    ScoreInterface* self = m.get();
+    m->log_ = [self](const std::string& line) { self->Log(line); };
+  }
+  m->ports_ = std::move(ports);
+  m->client_ = std::move(client);
+  m->gate_ = std::make_unique<CandidateRecordGate>(m->ports_.record.get(), m->log_);
+  m->command_writer_ =
+      std::make_unique<DrivingCommandWriter>(m->ports_.command.get(), m->gate_.get(), &m->clock_, m->log_);
+  m->warning_writer_ = std::make_unique<WarningRequestWriter>(m->ports_.warning.get(), &m->clock_, m->log_);
+  m->camera_ = std::make_shared<ScoreCameraInterface>(&m->clock_, m->log_);
+  SimulatorClient* raw_client = m->client_.get();
+  m->vehicle_ = std::make_shared<ScoreVehicleInterface>(
+      [raw_client](EgoVelocity* v) { return raw_client->NewestEgoVelocity(v); }, m->command_writer_.get(), m->log_);
+  m->publisher_ = std::make_unique<ScoreWarningRequestPublisher>(m->warning_writer_.get());
+  m->lifecycle_ = std::move(lifecycle);
+  m->supervision_ = std::make_unique<CycleSupervision>(m->lifecycle_.get(), m->log_);
+
+  if (!m->client_->Attach(error)) return nullptr;
+  ScoreCameraInterface* camera = m->camera_.get();
+  if (!m->client_->Start([camera](const CameraImageView& image) { camera->OnImage(image); }, error)) {
+    return nullptr;
+  }
+  m->camera_->SetOpen(true);
+  m->Log(std::string("{\"kind\":\"start\",\"mono_ns\":") + std::to_string(MonotonicNs()) +
+         ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+  if (!m->lifecycle_) {
+    m->Log("{\"kind\":\"supervision.off\",\"reason\":\"" + Escaped(off_reason) + "\",\"mono_ns\":" +
+           std::to_string(MonotonicNs()) + ",\"real_ns\":" + std::to_string(RealtimeNs()) + "}");
+  }
+  return m;
+}
+
+void ScoreInterface::CycleCompleted() {
+  if (supervision_) supervision_->CycleCompleted(StopRequested());
+}
+
+ScoreInterface::~ScoreInterface() {
+  if (supervision_) supervision_->Stop();  // no alive notification after this
+  if (client_) client_->Stop();  // no image callback after this
+  const std::string summary = Summary();
+  std::fprintf(stderr, "[DE4SDV] S-CORE interface summary %s\n", summary.c_str());
+  Log(summary);
+  if (log_file_ != nullptr) std::fclose(log_file_);
+}
+
+void ScoreInterface::Log(const std::string& line) {
+  std::lock_guard<std::mutex> lock(log_mutex_);
+  if (log_file_ == nullptr) return;
+  std::fputs(line.c_str(), log_file_);
+  std::fputc('\n', log_file_);
+  std::fflush(log_file_);
+}
+
+std::string ScoreInterface::Summary() const {
+  const CameraStats cs = camera_ ? camera_->get_camera_stats() : CameraStats{};
+  const DrivingCommandWriter::Counters cc = command_writer_ ? command_writer_->counters() : DrivingCommandWriter::Counters{};
+  const WarningRequestWriter::Counters wc = warning_writer_ ? warning_writer_->counters() : WarningRequestWriter::Counters{};
+  std::string s = "{\"kind\":\"summary\"";
+  s += ",\"images_received\":" + std::to_string(cs.frames_received);
+  s += ",\"images_dropped\":" + std::to_string(cs.frames_dropped);
+  s += ",\"images_handed_on\":" + std::to_string(cs.frames_captured);
+  s += ",\"image_conversion_errors\":" + std::to_string(cs.conversion_errors);
+  s += ",\"commands_sent\":" + std::to_string(cc.sent);
+  s += ",\"commands_send_failed\":" + std::to_string(cc.send_failed);
+  s += ",\"commands_withheld_before_record\":" + std::to_string(cc.withheld_before_record);
+  s += ",\"commands_withheld_without_capture_time\":" + std::to_string(cc.withheld_without_capture_time);
+  s += ",\"candidate_records_rejected\":" + std::to_string(gate_ ? gate_->rejected() : 0);
+  s += ",\"warning_events_sent\":" + std::to_string(wc.sent);
+  s += ",\"warning_events_requested\":" + std::to_string(wc.requested);
+  s += ",\"warning_events_send_failed\":" + std::to_string(wc.send_failed);
+  s += ",\"warning_events_not_encodable\":" + std::to_string(wc.not_encodable);
+  s += ",\"speed_unavailable\":" + std::to_string(vehicle_ ? vehicle_->speed_unavailable() : 0);
+  s += ",\"alive_reported\":" + std::to_string(supervision_ ? supervision_->alive_reported() : 0);
+  s += ",\"mono_ns\":" + std::to_string(MonotonicNs()) + "}";
+  return s;
+}
+
+}  // namespace de4sdv::score_interface
