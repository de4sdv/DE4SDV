+// ---------------------------------------------------------------------------
+// DE4SDV event-trigger patch (not upstream): one task chain per external frame event.
+// The input activity sends one datagram to FEO_PACE_SOCKET per complete frame.
+// ---------------------------------------------------------------------------
+struct PaceGate {
+    socket: std::os::unix::net::UnixDatagram,
+}
+
+impl PaceGate {
+    fn from_env() -> Option<Self> {
+        let path = std::env::var("FEO_PACE_SOCKET").ok()?;
+        let _ = std::fs::remove_file(&path);
+        match std::os::unix::net::UnixDatagram::bind(&path) {
+            Ok(socket) => {
+                if let Err(e) = socket.set_read_timeout(Some(std::time::Duration::from_millis(50))) {
+                    error!("Failed to set the pacing timeout on {path}: {e:?}; falling back to timer");
+                    return None;
+                }
+                info!("External event pacing enabled from {path}");
+                Some(Self { socket })
+            }
+            Err(e) => {
+                error!("Failed to bind pacing socket {path}: {e:?}; falling back to timer");
+                None
+            }
+        }
+    }
+
+    /// Blocks until a frame datagram arrives, then drains the datagrams queued meanwhile.
+    /// Returns the number consumed (>= 1), or None on a stop request or a socket failure.
+    fn wait(&mut self, stop: &std::sync::atomic::AtomicBool) -> Option<u64> {
+        use std::io::ErrorKind;
+        let mut buf = [0u8; 16];
+        loop {
+            if stop.load(std::sync::atomic::Ordering::Relaxed) {
+                return None;
+            }
+            match self.socket.recv(&mut buf) {
+                Ok(_) => break,
+                Err(e) if matches!(e.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut | ErrorKind::Interrupted) => {
+                    continue
+                }
+                Err(e) => {
+                    error!("Pacing receive failed: {e:?}");
+                    return None;
+                }
+            }
+        }
+        let mut events: u64 = 1;
+        if self.socket.set_nonblocking(true).is_ok() {
+            while self.socket.recv(&mut buf).is_ok() {
+                events += 1;
+            }
+            let _ = self.socket.set_nonblocking(false);
+        }
+        Some(events)
+    }
+}
