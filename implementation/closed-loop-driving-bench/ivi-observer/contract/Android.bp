// DE4SDV INC-DRIVING-001 slice 10b: the typed contracts of the observation path.
//
// de4sdv_driving_operational_state.proto is the VSIDL message of the Data Tunnel
// topic and the compile-time type of the observer app (option B: the typed message).
// Its field names and types are held to interfaces/ICD.md v2 section 3 by
// tests/test_contract_and_encoding.py.
//
// The module below is built inside the AOSP tree twice, from the same file:
//   * for the SDV Core product, by the catalog module that
//     scripts/stage_sdv_core_interop.sh appends to the catalog's Android.bp, so
//     vsidlc can resolve the type of the broker's publication;
//   * for the IVI product, by this module, linked into the app.
// Two module names, one source; the staging scripts copy this file, they do not
// fork it.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "de4sdv_driving_operational_state_proto_java",
    srcs: ["de4sdv_driving_operational_state.proto"],
    proto: {
        type: "lite",
    },
    sdk_version: "system_current",
    owner: "de4sdv",
}

// Only the proto is a Soong input here. The .vsidl mapping, the bundle
// declaration and the type_definition fragment are data for the broker and for
// review; scripts/stage_sdv_core_interop.sh copies them into the catalog, and a
// filegroup cannot reach outside its own directory.
filegroup {
    name: "de4sdv_driving_operational_state_contract_sources",
    srcs: ["de4sdv_driving_operational_state.proto"],
}
