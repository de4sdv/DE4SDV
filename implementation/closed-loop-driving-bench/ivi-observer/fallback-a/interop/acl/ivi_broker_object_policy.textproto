# DE4SDV INC-DRIVING-001 slice 10b, typed observation path (GAP-DRIVING-006).
# Bench-only.
#
# The broker's object policy on the IVI VM. A cross-VM subscriber needs the
# remote publisher's object policy as well as its own subject grant: the IVI SD
# agent builds the AuthzGuard of the broker unit from this package and bundle's
# policy, so the deprecated service_units mapping must name the observer as a
# reader of the topic (same file as the AEBS frame bench's
# ivi-acl/broker_object_policy.textproto).
#
# Installed at
#   /product/etc/sdv_authz_acls/com.android.sdv.someip/SomeIpBroker.textproto
# The reader name is the observer's subject package.bundle (dotted), not its
# process or activity name.
subscriber {
  message: "com.android.sdv.someip.De4sdvDrivingOperationalStateFrame"
  topic: "de4sdv-driving-operational-state"
}
acls {
  name: "DrivingStateObserverReader"
  include: "org.de4sdv.drivingstate.DrivingStateObserver"
}
service_units {
  name: "de4sdv-driving-operational-state"
  acl_names: "DrivingStateObserverReader"
}
