<?xml version="1.0" encoding="utf-8"?>
<!--
  DE4SDV INC-AEBS-010 bench patch. NOT NEEDED and not applied.

  Declares the SDV Certificate Authority and Identity Agent binder services in
  a framework manifest fragment for sdv_ivi_cf.

  The diagnosis this fragment was written for is disproven. The
  FAILED_PRECONDITION of the first PF-004 probe came from the probe not
  starting the Binder thread pool, not from a missing declaration. The
  corrected probe ran on the stock image without this fragment and passed on
  2026-08-29: initComms() succeeded and five frames were published
  (../../evidence/010/preflight/PF-004-STATUS.md).

  Nothing was reported upstream. The drafted report is withdrawn
  (../../upstream/README.md).

  This file is NOT part of the DE4SDV model baseline. It is kept as the record
  of the fix path that PF-004 ruled out.
-->
<manifest version="1.0" type="framework">
    <hal max-level="7" format="aidl">
        <name>google.sdv.ca.ICertificateAuthority</name>
        <version>1</version>
        <interface>
            <name>ICertificateAuthority</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal max-level="7" format="aidl">
        <name>google.sdv.identity.IIdentityAgent</name>
        <version>1</version>
        <interface>
            <name>IIdentityAgent</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
