<?xml version="1.0" encoding="utf-8"?>
<!-- DE4SDV AEBS 010 center-display layout: situation radar + disposition. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF101418">

    <org.de4sdv.aebsvisualization.SituationRadarView
        android:id="@+id/radar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.38"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/disposition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="52sp"
            android:textStyle="bold"
            android:text="@string/initial_disposition" />

        <TextView
            android:id="@+id/provenance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:textSize="13sp"
            android:text="@string/provenance_footer" />
    </LinearLayout>
</LinearLayout>
